# Домен, на который смотрит A-запись (для HTTPS через Caddy)
DOMAIN=cisbanka.example.ru

# Секрет подписи сессий: длинная случайная строка (openssl rand -hex 32)
JWT_SECRET=

# Код приглашения для регистрации учителей (сообщайте только учителям)
ADMIN_INVITE_CODE=

# Порт приложения на 127.0.0.1 хоста (нужен, если стоите за своим nginx)
APP_PORT=3000

# Сколько попыток входа в минуту разрешено с одного IP
LOGIN_RATE_LIMIT=10

# На сервере: брать готовый образ из GHCR вместо сборки.
# С этой строкой обычные docker compose pull / up -d / scripts/backup.sh работают с docker-compose.prod.yml
# COMPOSE_FILE=docker-compose.prod.yml
# Версия образа (latest или sha-<коммит> для отката)
# CISBANKA_TAG=latest
# Потолок памяти приложения
# APP_MEM_LIMIT=512m
